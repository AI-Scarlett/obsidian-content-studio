{
  "manifest_version": 3,
  "name": "墨稿 · 浏览器发布助手（预览版）",
  "version": "0.3.2",
  "description": "从 Obsidian 墨稿点发布，自动打开平台并同步整篇图文。登录后继续，最终发表由你确认。平台兼容性测试中。",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://creator.xiaohongshu.com/*",
    "https://mp.weixin.qq.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://x.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "launcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "墨稿发布助手"
  },
  "background": {
    "service_worker": "background.js"
  }
}
