{
  "manifest_version": 3,
  "name": "墨稿 · 整篇图文导入（预览版）",
  "version": "0.1.0",
  "description": "将墨稿文章与本地图片按原位置导入长文编辑器。仅在点击时运行，不自动发布。平台兼容性测试中。",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting"],
  "action": {"default_title": "导入墨稿整篇图文"},
  "background": {"service_worker": "background.js"}
}
